---
// The Loop-μP + SMELT talk as a 16:9 web slide deck. Slides come from
// src/data/loop-science/slides.ts; figures are the articles' own components.
// Without JavaScript the slides are stacked in reading order; the deck script
// adds paging, scaling, notes, the presenter view and the slide list.
import { getCollection } from 'astro:content';
import loopAuthors from '../../data/loop-mup/authors.json';
import loopBib from '../../data/loop-mup/citation.bib?raw';
import smeltAuthors from '../../data/smelt/authors.json';
import smeltBib from '../../data/smelt/citation.bib?raw';
import { slides, type Part, type Slide, type Text } from '../../data/loop-science/slides';
import { bibReference, clock, paragraphs, plainText, rich } from '../../lib/loop-science/rich';
import { blogPath, type Language } from '../../lib/site';
import DeckFigure from './DeckFigure.astro';
import '../../styles/deck.css';
interface Props { language: Language }
const { language } = Astro.props;
const zh = language === 'zh';
const t = (text: Text) => text[language];
const total = slides.length;

const posts = await getCollection('blog', ({ data }) => data.language === language);
const post = (slug: string) => posts.find(entry => entry.data.urlSlug === slug)!.data;
const articles = { loop: post('loop-mup'), smelt: post('smelt') };
const authors = { loop: loopAuthors[language], smelt: smeltAuthors[language] };
const references = [bibReference(loopBib), bibReference(smeltBib)];
const articleUrl = (slug: string) => new URL(blogPath(language, slug), Astro.site).href;
const deckUrl = new URL(blogPath(language, 'loop-science'), Astro.site).href;

const starts = slides.reduce<number[]>((list, _, index) => [...list, index ? list[index - 1]! + slides[index - 1]!.minutes : 0], []);
const totalMinutes = starts.at(-1)! + slides.at(-1)!.minutes;
const partMinutes = (part: Part) => slides.filter(slide => slide.part === part).reduce((sum, slide) => sum + slide.minutes, 0);
const partStages = (part: Part) => {
  const order: { name: string; minutes: number }[] = [];
  for (const slide of slides.filter(item => item.part === part && item.stage)) {
    const name = t(slide.stage!);
    const found = order.find(entry => entry.name === name);
    if (found) found.minutes += slide.minutes; else order.push({ name, minutes: slide.minutes });
  }
  return order;
};
const partName: Record<Part, string> = { intro: zh ? '开场' : 'Opening', loop: 'Loop-μP', smelt: 'SMELT' };
const partNumber: Partial<Record<Part, string>> = { loop: '01', smelt: '02' };
const about = (minutes: number) => zh ? `约 ${Math.round(minutes)} 分` : `≈ ${Math.round(minutes)} min`;
const minutesShort = (minutes: number) => zh ? `${minutes.toFixed(1)} 分` : `${minutes.toFixed(1)} min`;

const ui = zh ? {
  deck: '幻灯片', prev: '上一页', next: '下一页', notes: '备注', presenter: "备注窗口", overview: '目录', fullscreen: '全屏', exitFullscreen: '退出全屏', help: '按键说明',
  language: 'EN', languageLabel: '切换到英文版', toolbar: '幻灯片控制', source: '来源：', todo: '待补充', page: '页',
  elapsed: '已用', planned: '计划', reset: '重置', upNext: '下一页', noNext: '最后一页', notesTitle: '演讲备注', close: '关闭', jump: '跳到第',
  overviewTitle: '页面目录', helpTitle: "按键说明",
  keys: [
    ['→ ↓ PageDown 空格', '下一页'], ['← ↑ PageUp', '上一页'], ['Home / End', '第一页 / 最后一页'], ['数字 + Enter', '跳到指定页'],
    ['F', '全屏'], ['S', '备注面板'], ["P", "备注窗口（新窗口，与本页同步翻页）"], ['O', '页面目录'], ["L", "切换语言"], ['?', '按键说明'], ['Esc', '关闭面板；焦点在图内时退出图'],
  ],
  keyNote: '焦点在交互图内时，方向键交给图使用；按 Esc 退出后即可继续翻页。',
} : {
  deck: 'slide', prev: 'Previous slide', next: 'Next slide', notes: 'Notes', presenter: 'Presenter view', overview: 'Slides', fullscreen: 'Full screen', exitFullscreen: 'Exit full screen', help: 'Keys',
  language: '中文', languageLabel: 'Switch to the Chinese version', toolbar: 'Slide controls', source: 'Source: ', todo: 'To be added', page: 'Slide',
  elapsed: 'Elapsed', planned: 'Planned', reset: 'Reset', upNext: 'Next', noNext: 'Last slide', notesTitle: 'Speaker notes', close: 'Close', jump: 'Go to slide',
  overviewTitle: 'All slides', helpTitle: 'Keyboard shortcuts',
  keys: [
    ['→ ↓ PageDown Space', 'Next slide'], ['← ↑ PageUp', 'Previous slide'], ['Home / End', 'First / last slide'], ['Number + Enter', 'Go to that slide'],
    ['F', 'Full screen'], ['S', 'Notes panel'], ['P', 'Presenter view (new window, pages in sync)'], ['O', 'Slide list'], ['L', 'Switch language'], ['?', 'This help'], ['Esc', 'Close panels; leave a focused figure'],
  ],
  keyNote: 'While a figure has focus, the arrow keys belong to the figure; press Esc to leave it and keep paging.',
};
const otherLanguage = blogPath(zh ? 'en' : 'zh', 'loop-science');
const kicker = (slide: Slide) => [partName[slide.part], slide.stage && t(slide.stage)].filter(Boolean) as string[];
---
<main id="main" class="deck" data-deck data-language={language} data-total={total} data-total-minutes={totalMinutes}>
  <div class="deck-viewport" data-deck-viewport>
    <div class="deck-stage" data-deck-stage>
      {slides.map((slide, index) => {
        const number = index + 1;
        const title = t(slide.title);
        const part = slide.part;
        return <section
          class:list={['slide', `layout-${slide.layout}`, `part-${part}`]}
          id={`slide-${number}`}
          data-slide={index}
          data-minutes={slide.minutes}
          data-start={starts[index]}
          data-title={plainText(title)}
          data-part-name={partName[part]}
          aria-roledescription={ui.deck}
          aria-label={`${number} / ${total}: ${plainText(title)}`}
        >
          {slide.layout === 'cover' && <div class="cover">
            <p class="slide-kicker"><span class="kicker-part">Loop-μP · SMELT</span></p>
            <h1 class="cover-title" set:html={rich(title)} />
            {slide.lead && <p class="cover-lead" set:html={rich(t(slide.lead))} />}
            <ol class="cover-agenda">
              {(['loop', 'smelt'] as const).map(key => <li class:list={['agenda-item', `is-${key}`]}>
                <span class="agenda-number">{partNumber[key]}</span>
                <span class="agenda-name">{partName[key]}</span>
                <span class="agenda-subtitle">{articles[key].subtitle}</span>
                <span class="agenda-time">{about(partMinutes(key))}</span>
              </li>)}
            </ol>
            {slide.todo && <p class="cover-todo">{slide.todo.map(item => <span class="todo-tag">{t(item)}{zh ? "：" : ": "}{ui.todo}</span>)}</p>}
          </div>}

          {slide.layout === 'section' && (part === 'loop' || part === 'smelt') && <div class="section-slide">
            <p class="section-number">{partNumber[part]}</p>
            <div class="section-main">
              <h2 class="section-title" set:html={rich(title)} />
              {slide.lead && <p class="section-lead" set:html={rich(t(slide.lead))} />}
              <p class="section-authors">{authors[part].names.map(author => <span>{author.name}<sup>{author.markers}</sup></span>)}</p>
              <p class="section-affiliations">{authors[part].affiliations.map(affiliation => <span><sup>{affiliation.marker}</sup>{affiliation.name}</span>)}{authors[part].roles.map(role => <span>{role}</span>)}</p>
              <p class="section-meta">
                {articles[part].paper && <a href={articles[part].paper} target="_blank" rel="noopener noreferrer">arXiv:{references[part === 'loop' ? 0 : 1]!.eprint} ↗</a>}
                <a href={blogPath(language, part === 'loop' ? 'loop-mup' : 'smelt')} target="_blank" rel="noopener">{zh ? '博文' : 'Article'} ↗</a>
                <span>{about(partMinutes(part))}</span>
              </p>
              <ol class="section-arc">{partStages(part).map(stage => <li><span>{stage.name}</span><small>{minutesShort(stage.minutes)}</small></li>)}</ol>
            </div>
          </div>}

          {slide.layout === 'end' && <div class="end-slide">
            <h2 class="end-title" set:html={rich(title)} />
            <ol class="end-references">
              {references.map((reference, position) => <li>
                <span class="reference-authors">{reference.authors.join(', ')}.</span>
                <span class="reference-title">{reference.title}.</span>
                <span class="reference-venue">arXiv:{reference.eprint}, {reference.year}.</span>
                <span class="reference-links"><a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.url.replace(/^https?:\/\//, '')}</a> · <a href={articleUrl(position ? 'smelt' : 'loop-mup')} target="_blank" rel="noopener">{articleUrl(position ? 'smelt' : 'loop-mup').replace(/^https?:\/\//, '')}</a></span>
              </li>)}
            </ol>
            <p class="end-deck">{zh ? '在线版本：' : 'These slides: '}<a href={deckUrl}>{deckUrl.replace(/^https?:\/\//, '')}</a></p>
          </div>}

          {!['cover', 'section', 'end'].includes(slide.layout) && <>
            <header class="slide-head">
              <p class="slide-kicker">{kicker(slide).map((item, position) => <span class={position ? 'kicker-stage' : 'kicker-part'}>{item}</span>)}</p>
              <h2 class="slide-title" set:html={rich(title)} />
              {slide.lead && <p class="slide-lead" set:html={rich(t(slide.lead))} />}
            </header>
            <div class:list={['slide-body', `is-${slide.layout}`]} style={slide.textWidth ? `--text-w:${slide.textWidth}px` : undefined}>
              {slide.layout === 'cards' && slide.cards && <div class="slide-cards" style={`--cards:${slide.cards.length}`}>
                {slide.cards.map((card, position) => <article class="slide-card">
                  <p class="card-tag" set:html={card.tag ? rich(t(card.tag)) : String(position + 1).padStart(2, "0")} />
                  <h3 class="card-title" set:html={rich(t(card.title))} />
                  <p class="card-body" set:html={rich(t(card.body))} />
                </article>)}
              </div>}
              {slide.layout === 'cards' && slide.callout && <p class="slide-callout" set:html={rich(t(slide.callout))} />}

              {slide.layout === 'columns' && slide.columns && <div class="slide-columns">
                {slide.columns.map(column => <div class:list={['slide-column', column.tone && `is-${column.tone}`]}>
                  <h3 class="column-title">{t(column.title)}</h3>
                  <ul class="slide-points">{column.items[language].map(item => <li set:html={rich(item)} />)}</ul>
                </div>)}
              </div>}

              {(slide.layout === 'split' || slide.layout === 'stack') && <>
                {(slide.stats || slide.points || slide.callout || slide.foot) && <div class="slide-text">
                  {slide.stats && <div class="slide-stats" style={`--stats:${slide.stats.length}`}>{slide.stats.map(stat => <div class="slide-stat">
                    <span class:list={['stat-value', stat.tone && `is-${stat.tone}`]} set:html={rich(stat.value)} />
                    <span class="stat-label" set:html={rich(t(stat.label))} />
                  </div>)}</div>}
                  {slide.points && (slide.numbered
                    ? <ol class="slide-points is-numbered">{slide.points[language].map(item => <li set:html={rich(item)} />)}</ol>
                    : <ul class="slide-points">{slide.points[language].map(item => <li set:html={rich(item)} />)}</ul>)}
                  {slide.callout && <p class="slide-callout" set:html={rich(t(slide.callout))} />}
                  {slide.foot && <p class="slide-footnote" set:html={rich(t(slide.foot))} />}
                </div>}
                <div class="slide-visual">
                  {slide.visual === 'loop-schematic' && <div class="loop-schematic">
                    <svg viewBox="0 0 460 250" role="img" aria-label={zh ? '示意图：同一组 L 层共享权重，重复执行 N 次。' : 'Illustration: one stack of L layers with shared weights, executed N times.'}>
                      <defs>
                        <marker id="schematic-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="9" markerHeight="9" orient="auto"><path d="M1 1L9 5L1 9" class="schematic-head" /></marker>
                        <marker id="schematic-arrow-loop" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M1 1L9 5L1 9" class="schematic-head is-loop" /></marker>
                      </defs>
                      <line x1="18" y1="160" x2="132" y2="160" class="schematic-rail" marker-end="url(#schematic-arrow)" />
                      <line x1="328" y1="160" x2="442" y2="160" class="schematic-rail" marker-end="url(#schematic-arrow)" />
                      <text x="18" y="190" class="schematic-io">{zh ? '输入' : 'input'}</text>
                      <text x="442" y="190" text-anchor="end" class="schematic-io">{zh ? '输出' : 'output'}</text>
                      {[0, 1, 2, 3].map(row => <rect x="148" y={112 + row * 25} width="164" height="19" rx="3" class="schematic-layer" />)}
                      <text x="230" y="230" text-anchor="middle" class="schematic-label">{zh ? '同一组 ' : 'one stack of '}<tspan font-style="italic">L</tspan>{zh ? ' 层，共享权重' : ' layers, shared weights'}</text>
                      <path d="M312 120 C 380 120, 380 40, 230 40 C 80 40, 80 120, 148 120" class="schematic-loop" marker-end="url(#schematic-arrow-loop)" />
                      <text x="230" y="28" text-anchor="middle" class="schematic-times">× <tspan font-style="italic">N</tspan></text>
                    </svg>
                    <div class="slide-stats" style="--stats:2">
                      <div class="slide-stat"><span class="stat-value is-base" set:html={rich(zh ? '$L$ 层' : '$L$')} /><span class="stat-label">{zh ? '参数' : 'layers of parameters'}</span></div>
                      <div class="slide-stat"><span class="stat-value is-loop" set:html={rich(zh ? '$N$ × $L$ 层' : '$N$ × $L$')} /><span class="stat-label">{zh ? '执行深度' : 'layers executed'}</span></div>
                    </div>
                  </div>}
                  {slide.figures?.map(figure => <DeckFigure figure={figure} language={language} />)}
                </div>
              </>}
            </div>
          </>}

          <footer class="slide-foot">
            <span class="foot-part">{partName[part]}</span>
            {slide.source && <span class="foot-source">{ui.source}{t(slide.source)}</span>}
            <span class="foot-page">{number} / {total}</span>
          </footer>
          <div class="slide-progress" aria-hidden="true" style={`--progress:${(number / total * 100).toFixed(2)}%`}></div>
          <div class="slide-notes" hidden set:html={paragraphs(t(slide.notes))} />
        </section>;
      })}
    </div>
  </div>

  <nav class="deck-toolbar" data-deck-toolbar aria-label={ui.toolbar}>
    <button type="button" data-deck-prev aria-label={ui.prev}><span aria-hidden="true">‹</span></button>
    <span class="deck-count" aria-live="polite"><span data-deck-current>1</span><span aria-hidden="true"> / </span><span class="sr-only"> {zh ? '共' : 'of'} </span>{total}</span>
    <button type="button" data-deck-next aria-label={ui.next}><span aria-hidden="true">›</span></button>
    <span class="deck-toolbar-sep" aria-hidden="true"></span>
    <a href={otherLanguage} data-deck-language hreflang={zh ? 'en' : 'zh-CN'} lang={zh ? 'en' : 'zh-CN'} aria-label={ui.languageLabel}>{ui.language}</a>
    <button type="button" data-deck-toggle="notes" aria-pressed="false">{ui.notes}</button>
    <button type="button" data-deck-presenter>{ui.presenter}</button>
    <button type="button" data-deck-toggle="overview" aria-pressed="false">{ui.overview}</button>
    <button type="button" data-deck-fullscreen data-label-enter={ui.fullscreen} data-label-exit={ui.exitFullscreen}>{ui.fullscreen}</button>
    <button type="button" data-deck-toggle="help" aria-pressed="false" aria-label={ui.help}>?</button>
  </nav>
  <p class="deck-jump" data-deck-jump hidden><span>{ui.jump}</span> <b data-deck-jump-value></b></p>

  <aside class="deck-notes" data-deck-panel="notes" aria-label={ui.notesTitle} hidden>
    <header class="notes-header">
      <p class="notes-position"><span data-notes-page></span><span data-notes-part></span></p>
      <p class="notes-timer"><span>{ui.elapsed} <b data-notes-elapsed>0:00</b></span><span>{ui.planned} <b data-notes-planned></b></span><button type="button" data-notes-reset>{ui.reset}</button></p>
      <h2 class="notes-title" data-notes-title></h2>
    </header>
    <div class="notes-body" data-notes-body></div>
    <p class="notes-next"><span>{ui.upNext}</span> <b data-notes-next data-empty={ui.noNext}></b></p>
  </aside>

  <div class="deck-overlay" data-deck-panel="overview" role="dialog" aria-modal="true" aria-labelledby="deck-overview-title" hidden>
    <div class="overlay-box is-overview">
      <header><h2 id="deck-overview-title">{ui.overviewTitle}</h2><span>{zh ? `共 ${total} 页 · ${about(totalMinutes)}` : `${total} slides · ${about(totalMinutes)}`}</span><button type="button" data-deck-close aria-label={ui.close}>×</button></header>
      <ol class="overview-list">
        {slides.map((slide, index) => <li class:list={[`part-${slide.part}`]}>
          <button type="button" data-deck-goto={index}>
            <span class="overview-number">{index + 1}</span>
            <span class="overview-text"><span class="overview-meta">{kicker(slide).join(' · ')}</span><span class="overview-title">{plainText(t(slide.title))}</span></span>
            <span class="overview-time">{clock(starts[index]!)}</span>
          </button>
        </li>)}
      </ol>
    </div>
  </div>

  <div class="deck-overlay" data-deck-panel="help" role="dialog" aria-modal="true" aria-labelledby="deck-help-title" hidden>
    <div class="overlay-box is-help">
      <header><h2 id="deck-help-title">{ui.helpTitle}</h2><button type="button" data-deck-close aria-label={ui.close}>×</button></header>
      <dl class="help-keys">{ui.keys.map(([keys, action]) => <><dt>{keys}</dt><dd>{action}</dd></>)}</dl>
      <p class="help-note">{ui.keyNote}</p>
    </div>
  </div>
</main>
<script is:inline>
  // Runs while the page parses, before the module scripts: show the slide named
  // in the hash and size the stage, so the first paint is already the deck.
  (() => {
    const deck = document.querySelector('[data-deck]');
    if (!deck) return;
    const slides = deck.querySelectorAll('[data-slide]');
    const asked = parseInt(location.hash.slice(1), 10);
    const index = asked >= 1 && asked <= slides.length ? asked - 1 : 0;
    slides[index].classList.add('is-active');
    deck.dataset.index = String(index);
    if (new URLSearchParams(location.search).has('presenter')) deck.classList.add('is-presenter', 'notes-open');
    const viewport = deck.querySelector('[data-deck-viewport]');
    const stage = deck.querySelector('[data-deck-stage]');
    const box = viewport.getBoundingClientRect();
    stage.style.setProperty('--s', String(Math.min(box.width / 1280, box.height / 720)));
  })();
</script>
<script>
  import '../../scripts/deck';
</script>
