---
// Figure 13: SMELT's accuracy lead vs number of in-context examples, for the
// 16-task mean and every task, with a selected task shown in full on the right.
import { accuracyDomain, accuracyPoints, allShots, columnTip, columnWidth, curveOf, defaultTask, endLabel, frame, gapPath, gapScale, gapTicks, gaps, height, iclCopy, labelOf, lineTip, meanCurve, percentText, readout, signedPp, tasks, width, xAt } from '../../lib/smelt/icl-gain';
import { linePath, linear } from '../../lib/smelt/plot';
import type { Language } from '../../lib/site';
import '../../styles/smelt/icl-gain.css';
interface Props { language: Language; mode?: string; metric?: string }
const { language } = Astro.props;
const text = iclCopy(language);
const uid = `ig-${language}-${Math.random().toString(36).slice(2, 8)}`;
const selected = curveOf(defaultTask);
const accuracy = accuracyDomain(selected);
const y = linear(accuracy.domain, [frame.y0, frame.y1]);
const points = accuracyPoints(selected, accuracy.domain);
const meanGaps = gaps(meanCurve);
const dyck = gaps(selected);
const extraX = frame.x0 + 5 * columnWidth;
const others = tasks.filter(task => task.key !== defaultTask);
const sortedOptions = [...tasks].sort((a, b) => a.label.localeCompare(b.label));
const meanEnd = endLabel(meanCurve);
const selectedEnd = endLabel(selected, meanEnd);
const axisLabel = (value: number) => value < 0 ? `−${Math.abs(value)}` : String(value);
// "Held" range of the mean lead after the first example (k = 2 … 8).
const held = meanGaps.slice(2);
const heldLow = Math.min(...held).toFixed(1);
const heldHigh = Math.max(...held).toFixed(1);
---
<div class="icl-gain" data-icl-gain data-language={language}>
  <div class="smelt-stats ig-stats">
    <div class="smelt-stat"><span class="smelt-stat-value is-gain">{signedPp(meanGaps[0] ?? 0)}</span><span class="smelt-stat-label">{text.stat1}</span></div>
    <div class="smelt-stat"><span class="smelt-stat-value is-gain">{signedPp(meanGaps[1] ?? 0)}</span><span class="smelt-stat-label">{text.stat2(heldLow, heldHigh)}</span></div>
    <div class="smelt-stat"><span class="smelt-stat-value">{signedPp(dyck[dyck.length - 1] ?? 0)}</span><span class="smelt-stat-label">{text.stat3(percentText(selected.loop.at(-1) ?? 0), percentText(selected.base.at(-1) ?? 0))}</span></div>
  </div>
  <div class="smelt-controls ig-controls" data-js-only hidden>
    <label class="smelt-control">
      <span class="smelt-control-label">{text.task}</span>
      <select class="ig-select" data-ig-select>
        <option value="mean">{text.meanOption}</option>
        {sortedOptions.map(task => <option value={task.key} selected={task.key === defaultTask}>{task.label}</option>)}
      </select>
    </label>
  </div>
  <div class="smelt-panels ig-panels">
    <section class="smelt-panel" aria-label={text.gapTitle}>
      <h4>{text.gapTitle}</h4>
      <p>{text.gapNote}</p>
      <div class="smelt-legend ig-legend" aria-hidden="true">
        <span class="ig-key-mean"><i class="smelt-swatch"></i>{text.meanLegend}</span>
        <span class="ig-key-selected"><i class="smelt-swatch"></i><span data-ig-selected-name>{selected.label}</span></span>
        <span class="ig-key-other"><i class="smelt-swatch"></i>{text.otherLegend}</span>
      </div>
      <svg class="smelt-chart ig-chart ig-gap" viewBox={`0 0 ${width} ${height}`} role="group" aria-label={text.aria} data-reveal>
        <defs><clipPath id={`${uid}-a`}><rect class="reveal-grow-x" x={frame.x0 - 8} y={frame.y1 - 12} width={frame.x1 - frame.x0 + 16} height={frame.y0 - frame.y1 + 24} /></clipPath></defs>
        <rect class="ig-extra" x={extraX} y={frame.y1 - 8} width={frame.x1 - extraX} height={frame.y0 - frame.y1 + 8} />
        <text class="ig-extra-label" x={(extraX + frame.x1) / 2} y={frame.y1 - 13} text-anchor="middle">{language === 'zh' ? '仅 5 个任务' : '5 tasks only'}</text>
        {gapTicks.map(value => <line class:list={[value === 0 ? 'ig-zero' : 'grid']} x1={frame.x0} x2={frame.x1} y1={gapScale(value)} y2={gapScale(value)} />)}
        {gapTicks.map(value => <text x={frame.x0 - 8} y={gapScale(value) + 4.5} text-anchor="end">{axisLabel(value)}</text>)}
        {allShots.map(shot => <text x={xAt(shot)} y={frame.y0 + 19} text-anchor="middle">{shot}</text>)}
        <text class="axis-title" x={(frame.x0 + frame.x1) / 2} y={frame.y0 + 44} text-anchor="middle">{text.xAxis}</text>
        <text class="axis-title" transform={`translate(13 ${(frame.y0 + frame.y1) / 2}) rotate(-90)`} text-anchor="middle">{text.gapAxis}</text>
        <g clip-path={`url(#${uid}-a)`} data-ig-tasks>
          {[...others, selected].map(task => <g class="ig-task" data-task={task.key} data-selected={task.key === defaultTask ? '' : undefined} data-tip={lineTip(task, language)} tabindex="-1" aria-label={task.label}>
            <path class="ig-task-hit" d={gapPath(task)} />
            <path class="ig-task-line" d={gapPath(task)} />
            {gaps(task).map((gap, index) => <circle class="ig-task-dot" cx={xAt(task.shots[index] ?? 0)} cy={gapScale(gap)} r="3.6" />)}
          </g>)}
          <g class="ig-mean" data-tip={lineTip(meanCurve, language)} tabindex="-1">
            <path class="ig-task-hit" d={gapPath(meanCurve)} />
            <path class="ig-mean-line" d={gapPath(meanCurve)} />
            {meanGaps.map((gap, index) => <circle class="ig-mean-dot" cx={xAt(meanCurve.shots[index] ?? 0)} cy={gapScale(gap)} r="4.4" />)}
          </g>
        </g>
        <text class="ig-end ig-end-selected reveal-fade" data-ig-end x={selectedEnd.x} y={selectedEnd.y} text-anchor={selectedEnd.anchor} style="--i: 14">{selectedEnd.text}</text>
        <text class="ig-end ig-end-mean reveal-fade" x={meanEnd.x} y={meanEnd.y} text-anchor={meanEnd.anchor} style="--i: 12">{meanEnd.text}</text>
      </svg>
    </section>
    <section class="smelt-panel" aria-label={text.ariaAccuracy}>
      <h4 data-ig-title>{labelOf(selected, language)}</h4>
      <p>{text.accuracyNote}</p>
      <div class="smelt-legend ig-legend" aria-hidden="true">
        <span class="is-base"><i class="smelt-swatch ig-swatch-dashed"></i><i class="smelt-swatch-ring"></i>{text.base}</span>
        <span class="is-loop"><i class="smelt-swatch"></i><i class="smelt-swatch-dot"></i>SMELT</span>
        <span class="ig-key-gap"><i class="ig-swatch-gap"></i>{language === 'zh' ? '差值' : 'Gap'}</span>
      </div>
      <svg class="smelt-chart ig-chart ig-accuracy" viewBox={`0 0 ${width} ${height}`} role="group" aria-label={text.ariaAccuracy} data-reveal>
        <defs>
          <clipPath id={`${uid}-b`}><rect class="reveal-grow-x" x={frame.x0 - 8} y={frame.y1 - 12} width={frame.x1 - frame.x0 + 16} height={frame.y0 - frame.y1 + 24} /></clipPath>
          <clipPath id={`${uid}-grid`}><rect x="0" y={frame.y1 - 6} width={width} height={frame.y0 - frame.y1 + 12} /></clipPath>
        </defs>
        <rect class="ig-extra" x={extraX} y={frame.y1 - 8} width={frame.x1 - extraX} height={frame.y0 - frame.y1 + 8} />
        <g clip-path={`url(#${uid}-grid)`} data-ig-grid>
          {accuracy.ticks.map(value => <g class="ig-tick" data-value={value}><line class="grid" x1={frame.x0} x2={frame.x1} y1={y(value)} y2={y(value)} /><text x={frame.x0 - 8} y={y(value) + 4.5} text-anchor="end">{Number(value.toFixed(2))}</text></g>)}
        </g>
        <path class="axis" d={`M${frame.x0} ${frame.y0}H${frame.x1}`} />
        {allShots.map(shot => <text x={xAt(shot)} y={frame.y0 + 19} text-anchor="middle">{shot}</text>)}
        <text class="axis-title" x={(frame.x0 + frame.x1) / 2} y={frame.y0 + 44} text-anchor="middle">{text.xAxis}</text>
        <text class="axis-title" transform={`translate(13 ${(frame.y0 + frame.y1) / 2}) rotate(-90)`} text-anchor="middle">{text.accuracyAxis}</text>
        <line class="ig-guide" x1="0" x2="0" y1={frame.y1 - 4} y2={frame.y0} visibility="hidden" />
        <g clip-path={`url(#${uid}-b)`}>
          {points.base.map((point, index) => <line class:list={['ig-connector', { 'is-negative': (points.loop[index]![1]) > point[1] }]} data-index={index} x1={point[0]} x2={point[0]} y1={point[1]} y2={points.loop[index]![1]} />)}
          <path class="base-line ig-base-line" d={linePath(points.base)} />
          <path class="loop-line ig-loop-line" d={linePath(points.loop)} />
          {points.base.map((point, index) => <circle class="base-dot" data-ig-dot="base" data-index={index} cx={point[0]} cy={point[1]} r="3.8" data-pad={index >= selected.shots.length ? '' : undefined} />)}
          {points.loop.map((point, index) => <circle class="loop-dot" data-ig-dot="loop" data-index={index} cx={point[0]} cy={point[1]} r="4.2" data-pad={index >= selected.shots.length ? '' : undefined} />)}
        </g>
        {allShots.map((shot, index) => <g class="ig-col" data-index={index} data-tip={columnTip(selected, index, language) || `k = ${shot}`}><rect class="hit" x={xAt(shot) - columnWidth / 2} y={frame.y1 - 4} width={columnWidth} height={frame.y0 - frame.y1 + 4} /></g>)}
      </svg>
    </section>
  </div>
  <p class="smelt-readout ig-readout" data-ig-readout aria-live="polite">{readout(selected, language)}</p>
  <details class="disclosure smelt-data">
    <summary>{language === 'zh' ? '查看 16 个任务的准确率差' : 'Accuracy gap for all 16 tasks'}<span class="disclosure-plus" aria-hidden="true">+</span></summary>
    <div class="disclosure-body">
      <div class="data-scroll" tabindex="0" role="region" aria-label={text.aria}>
        <table class="data-table">
          <thead><tr><th scope="col">{text.task}</th>{allShots.map(shot => <th scope="col">k = {shot}</th>)}</tr></thead>
          <tbody>
            <tr data-highlight><th scope="row"><strong>{text.meanOption}</strong></th>{allShots.map((_, index) => <td><strong>{index < meanGaps.length ? signedPp(meanGaps[index] ?? 0, 2) : '—'}</strong></td>)}</tr>
            {sortedOptions.map(task => { const g = gaps(task); return <tr><th scope="row">{task.label}</th>{allShots.map((_, index) => <td>{index < g.length ? signedPp(g[index] ?? 0, 2) : '—'}</td>)}</tr>; })}
          </tbody>
        </table>
      </div>
      <p>{language === 'zh' ? '表中为 SMELT − 基线的准确率差（百分点）。' : 'Values are SMELT − Baseline accuracy in percentage points.'}</p>
    </div>
  </details>
  <div hidden><slot /></div>
</div>
<script>
  import '../../scripts/smelt/icl-gain';
</script>
