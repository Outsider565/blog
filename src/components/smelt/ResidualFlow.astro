---
// Figure 15: how much each looped layer writes into the residual stream on
// visit 1 and visit 2 (paired bars), and how aligned the two writes are (an
// angle glyph with the measured lengths and cosine). Data: src/data/smelt/residual-flow.json.
import { barLayout, barVariants, copy, defaultMetric, defaultSize, fmtRatio, fmtValue, fanShapes, glyph, glyphGeometry, glyphShapes, layerValues, metrics, protractor, scales, sizes, subtitle, summary, type Variant } from '../../lib/smelt/residual-flow';
import type { Language } from '../../lib/site';
import '../../styles/smelt/residual-flow.css';
interface Props { language: Language; mode?: string; metric?: string }
const { language } = Astro.props;
const text = copy[language];
const size = defaultSize;
const metric = defaultMetric;
const uid = `rf-${language}`;
const variants = Object.keys(barVariants) as Variant[];
const stats = summary(size, metric);
const average = layerValues(size, metric, null);
const geometry = glyphGeometry(size, metric, average);
const shapes = glyphShapes(geometry.theta, geometry.first, geometry.second, average.cos.toFixed(2));
const scaleData = scales[size];
const tip = (index: number) => {
  const pair = (series: 'attn' | 'moe') => [scaleData.v1[series][index] ?? 0, scaleData.v2[series][index] ?? 0] as [number, number];
  return text.tip(size, scaleData.layers[index] ?? 0, metric, scaleData.v1[metric][index] ?? 0, scaleData.v2[metric][index] ?? 0, pair('attn'), pair('moe'), scaleData.cos?.[index]);
};
const { ox, oy, radius } = glyph;
const arcRadius = radius + 10;
const polar = (cos: number, distance: number) => { const angle = Math.acos(cos); return [ox + distance * Math.cos(angle), oy - distance * Math.sin(angle)] as const; };
---
<div class="rf" data-residual-flow data-language={language} data-size={size} data-metric={metric}>
  <div class="smelt-controls">
    <div class="smelt-control">
      <span class="smelt-control-label" id={`${uid}-size`}>{text.scale}</span>
      <div class="smelt-seg" role="group" aria-labelledby={`${uid}-size`} data-rf-size>
        {sizes.map(entry => <button type="button" data-value={entry} aria-pressed={(entry === size) ? 'true' : 'false'}>{entry}</button>)}
      </div>
    </div>
    <div class="smelt-control">
      <span class="smelt-control-label" id={`${uid}-metric`}>{text.metric}</span>
      <div class="smelt-seg" role="group" aria-labelledby={`${uid}-metric`} data-rf-metric>
        {metrics.map(entry => <button type="button" data-value={entry} aria-pressed={(entry === metric) ? 'true' : 'false'}>{text.metricNames[entry]}</button>)}
      </div>
    </div>
  </div>

  <div class="rf-main" data-reveal>
    <section class="rf-panel rf-bars-panel" aria-label={text.barsTitle}>
      <header class="rf-panel-head rf-bars-head"><div><h4>{text.barsTitle}</h4><p data-rf-sub set:html={subtitle(text, metric)}></p></div>
        <div class="smelt-legend rf-legend"><span class="is-loop"><i class="rf-swatch is-v1"></i>{text.visit1}</span><span class="is-loop"><i class="rf-swatch is-v2"></i>{text.visit2}</span></div>
      </header>
      {variants.map(variant => {
        const layout = barLayout(size, metric, variant);
        const { box } = layout;
        return <svg class={`smelt-chart rf-bars is-${variant}`} viewBox={`0 0 ${box.width} ${box.height}`} role="group" aria-label={text.aria} data-rf-bars={variant}>
          <g data-rf-ticks>
            {layout.ticks.map(tick => <g><line class="grid" x1={box.left} x2={box.width - box.right} y1={tick.y} y2={tick.y} /><text x={box.left - 7} y={tick.y + 4.5} text-anchor="end">{tick.label}</text></g>)}
          </g>
          <g data-rf-strip>
            <text class="rf-strip-title" x={box.left} y={box.stripTop - 12}>{text.strip}</text>
            {layout.cosTicks.map(tick => <g><line class="grid" x1={box.left} x2={box.width - box.right} y1={tick.y} y2={tick.y} /><text x={box.left - 7} y={tick.y + 4.5} text-anchor="end">{tick.label}</text></g>)}
            {layout.cosPath ? <path class="rf-cos-line reveal-draw" pathLength="1" d={layout.cosPath} /> : <>
              <line class="rf-cos-mean" x1={box.left} x2={box.width - box.right} y1={layout.cosMean.y} y2={layout.cosMean.y} />
              <text class="rf-strip-note" x={box.width - box.right} y={box.stripTop - 12} text-anchor="end">{text.stripMean(layout.cosMean.value)}</text>
            </>}
          </g>
          <g data-rf-layers>
            {layout.layers.map(layer => <g class="rf-layer" data-index={layer.index} data-tip={tip(layer.index)} role="button" aria-pressed="false" aria-label={tip(layer.index).replaceAll('\n', '; ')}>
              <rect class="rf-col" x={layer.center - layout.band / 2} y={box.top - 10} width={layout.band} height={layout.baseline - box.top + 10} />
              <rect class="hit" x={layer.center - layout.band / 2} y={box.top - 10} width={layout.band} height={box.stripBottom - box.top + 14} />
              <rect class="rf-bar is-v1 reveal-grow" style={`--i:${layer.index}`} x={layer.first.x} y={layer.first.y} width={layout.barWidth} height={layout.baseline - layer.first.y} />
              <rect class="rf-bar is-v2 reveal-grow" style={`--i:${layer.index}`} x={layer.second.x} y={layer.second.y} width={layout.barWidth} height={layout.baseline - layer.second.y} />
              {layer.label && <text class="rf-tick" x={layer.center} y={box.labelY} text-anchor="middle">{layer.label}</text>}
              {layer.cos && <circle class="rf-cos-dot reveal-pop" style={`--i:${layer.index}`} cx={layer.center} cy={layer.cos.y} r="3.2" />}
            </g>)}
          </g>
          <line class="axis" x1={box.left} x2={box.width - box.right} y1={layout.baseline} y2={layout.baseline} />
          <text class="axis-title" x={(box.left + box.width - box.right) / 2} y={box.titleY} text-anchor="middle">{text.axisLayer}</text>
        </svg>;
      })}
    </section>

    <section class="rf-panel rf-glyph-panel" aria-label={text.glyphTitle}>
      <header class="rf-panel-head"><h4>{text.glyphTitle}</h4></header>
      <svg class="smelt-chart rf-glyph" viewBox={`0 0 ${glyph.width} ${glyph.height}`} role="img" aria-label={`${text.glyphTitle}: cos ${average.cos.toFixed(2)}`} data-rf-glyph>
        <path class="rf-protractor" d={`M${ox + arcRadius} ${oy}A${arcRadius} ${arcRadius} 0 0 0 ${ox} ${oy - arcRadius}`} />
        {protractor.map(cos => { const [x1, y1] = polar(cos, arcRadius); const [x2, y2] = polar(cos, arcRadius + 6); return <line class="rf-protractor-tick" x1={x1} y1={y1} x2={x2} y2={y2} />; })}
        <text class="rf-protractor-label" x={ox + arcRadius} y={oy + 19} text-anchor="middle">1</text>
        <text class="rf-protractor-label is-quiet" x={ox + arcRadius} y={oy + 35} text-anchor="middle">{text.same}</text>
        <text class="rf-protractor-label" x={polar(0.5, arcRadius + 10)[0] + 2} y={polar(0.5, arcRadius + 10)[1] - 2}>0.5</text>
        <text class="rf-protractor-label" x={ox + 8} y={oy - arcRadius - 5}>0 <tspan class="is-quiet">{text.orthogonal}</tspan></text>
        <line class="rf-ray" x1={ox} y1={oy} x2={ox + arcRadius} y2={oy} />
        <line class="rf-ray" x1={ox} y1={oy} x2={ox} y2={oy - arcRadius} />
        <g class="rf-fan" data-rf-fan>{fanShapes(size, metric).map(ray => <line x1={ox} y1={oy} x2={ray.x2} y2={ray.y2} data-index={ray.index} />)}</g>
        <path class="rf-angle" d={shapes.arc} data-rf-arc />
        <text class="rf-angle-label" x={shapes.arcLabel.x} y={shapes.arcLabel.y} data-rf-arc-label>{average.cos.toFixed(2)}</text>
        <line class="rf-drop" x1={shapes.drop.x1} y1={shapes.drop.y1} x2={shapes.drop.x2} y2={shapes.drop.y2} data-rf-drop />
        <path class="rf-square" d={shapes.square} data-rf-square />
        <line class="rf-vector is-v1" x1={ox} y1={oy} x2={shapes.first.x2} y2={shapes.first.y2} data-rf-v1 />
        <path class="rf-head is-v1" d={shapes.first.head} data-rf-v1-head />
        <line class="rf-vector is-v2" x1={ox} y1={oy} x2={shapes.second.x2} y2={shapes.second.y2} data-rf-v2 />
        <path class="rf-head is-v2" d={shapes.second.head} data-rf-v2-head />
        <circle class="rf-origin" cx={ox} cy={oy} r="2.6" />
        <text class="rf-vector-label is-v1" x={shapes.firstLabel.x} y={shapes.firstLabel.y} text-anchor="middle" data-rf-v1-label>{text.glyphVisit1}</text>
        <text class="rf-vector-label is-v2" x={shapes.secondLabel.x} y={shapes.secondLabel.y} data-rf-v2-label>{text.glyphVisit2}</text>
      </svg>
      <p class="rf-glyph-readout" data-rf-glyph-readout aria-live="polite" set:html={text.glyphReadout(text.blockAverage, average.second / average.first, average.cos)}></p>
    </section>
  </div>

  <div class="smelt-stats rf-stats">
    <div class="smelt-stat"><span class="smelt-stat-value is-loop" data-rf-stat="larger">{text.statLarger(stats.larger, stats.total)}</span><span class="smelt-stat-label">{text.statLargerLabel}</span></div>
    <div class="smelt-stat"><span class="smelt-stat-value is-loop" data-rf-stat="ratio">{fmtRatio(stats.ratio)}</span><span class="smelt-stat-label">{text.statRatioLabel}</span></div>
    <div class="smelt-stat"><span class="smelt-stat-value" data-rf-stat="cos">{stats.cos.toFixed(2)}</span><span class="smelt-stat-label" data-rf-stat-label="cos">{text.statCosLabel(stats.cos)}</span></div>
  </div>

  <details class="disclosure smelt-data">
    <summary>{text.dataSummary}<span class="disclosure-plus" aria-hidden="true">+</span></summary>
    <div class="data-scroll" tabindex="0" role="region" aria-label={text.dataSummary}>
      <table class="data-table">
        <thead><tr>{text.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
        <tbody>
          {sizes.flatMap(entry => scales[entry].layers.map((layer, index) => {
            const value = scales[entry];
            const first = value.v1.update[index] ?? 0;
            const second = value.v2.update[index] ?? 0;
            const cos = value.cos?.[index];
            return <tr>
              <th scope="row">{entry}</th><td>{layer}</td><td>{fmtValue(first)}</td><td>{fmtValue(second)}</td><td>{fmtRatio(second / first)}</td>
              <td>{fmtValue(value.v1.relative[index] ?? 0)}</td><td>{fmtValue(value.v2.relative[index] ?? 0)}</td>
              <td>{cos === undefined ? (index === 0 ? `${value.cosMean.toFixed(2)}*` : '') : cos.toFixed(2)}</td>
            </tr>;
          }))}
        </tbody>
      </table>
    </div>
    <p class="rf-data-note">{language === 'zh' ? '* 循环块平均。' : '* Block average.'}</p>
  </details>
  <div hidden><slot /></div>
</div>
<script src="../../scripts/smelt/residual-flow.ts"></script>
