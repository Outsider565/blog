---
import { pathTo, sectionPath, type Language, type SiteSection } from '../lib/site';
import { locales, type ArticleMetadata } from '../lib/metadata';
import themeScript from '../scripts/theme.js?raw';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  language: Language;
  section?: SiteSection;
  slug?: string;
  article?: ArticleMetadata;
  noindex?: boolean;
  canonicalPath?: string;
  translated?: boolean;
}
const { title, description, language, section = 'blog', slug, article, noindex = false, canonicalPath, translated = true } = Astro.props;
const canonical = new URL(canonicalPath || Astro.url.pathname, Astro.site);
const locale = locales[language];
const alternateLocale = locales[language === 'zh' ? 'en' : 'zh'];
const hasAlternates = translated && (!noindex || Boolean(canonicalPath));
---
<!doctype html>
<html lang={locale.html} prefix={`og: https://ogp.me/ns#${article ? ' article: https://ogp.me/ns/article#' : ''}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {article && <meta name="author" content={article.authors.join(', ')} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline data-theme-script set:html={themeScript}></script>
    <link rel="icon" type="image/svg+xml" href={pathTo('favicon.svg')} />
    {hasAlternates && <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="zh-CN" href={new URL(sectionPath('zh', section, slug), Astro.site)} />
      <link rel="alternate" hreflang="en" href={new URL(sectionPath('en', section, slug), Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(sectionPath('zh', section, slug), Astro.site)} />
    </>}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.openGraph} />
    {hasAlternates && <meta property="og:locale:alternate" content={alternateLocale.openGraph} />}
    {article && <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      {article.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
      <meta property="article:section" content={article.section} />
      {article.tags.map(tag => <meta property="article:tag" content={tag} />)}
    </>}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{language === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <slot />
  </body>
</html>
