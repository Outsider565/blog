---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticlePage from '../layouts/ArticlePage.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.language === 'zh');
  return posts.map(post => ({ params: { slug: post.data.urlSlug }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'> }
---
<ArticlePage post={Astro.props.post} />
